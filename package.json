{
  "name": "prettier-pre-commit",
  "private": true,
  "version": "1.0.9",
  "description": "Prettier hook for pre-commit (supports all Prettier file formats).",
  "license": "MIT",
  "bin": {
    "prettier-format": "./bin/prettier-format.js"
  },
  "dependencies": {
    "prettier": "3.6.2",
    "prettier-plugin-toml": "2.0.6"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "fmt": "node ./bin/prettier-format.js --write --ignore-unknown"
  }
}
